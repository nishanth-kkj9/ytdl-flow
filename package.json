{
  "name": "ytdl_modern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "cd web && node server.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:engine": "python -m PyInstaller --noconfirm --clean --onedir --name ytdl-flow-engine --distpath python-engine/binaries/engine-dist --workpath python-engine/build --specpath python-engine/build --collect-all yt_dlp --collect-all mutagen --collect-all certifi python-engine/ipc_main.py",
    "desktop:pack": "npm run build && npm run desktop:engine && electron-builder --win --dir",
    "desktop:dist": "npm run build && npm run desktop:engine && electron-builder --win nsis",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node test-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.2.8",
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.ytdlflow.app",
    "productName": "YTDL Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "web/**/*",
      "!web/tests/**/*",
      "!web/node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-engine/binaries/engine-dist/ytdl-flow-engine",
        "to": "engine"
      },
      {
        "from": "public/branding/ytdl-flow-icon.ico",
        "to": "branding/ytdl-flow-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/branding/ytdl-flow-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
