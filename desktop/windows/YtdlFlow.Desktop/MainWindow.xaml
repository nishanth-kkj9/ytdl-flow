<Window
    x:Class="YtdlFlow.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YtdlFlow.Desktop.Models"
    Title="YTDL Flow">
    <NavigationView
        x:Name="AppNavigationView"
        PaneDisplayMode="LeftCompact"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Download" Tag="Download" IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Queue" Tag="Queue">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="History" Tag="History">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Grid Padding="24">
                <Grid Visibility="{x:Bind ViewModel.DownloadPageVisibility, Mode=OneWay}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="Download from YouTube" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Probe a video, choose an output, and send it to the shared download engine."
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Padding="18"
                                CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBox
                                        Header="YouTube URL"
                                        PlaceholderText="https://www.youtube.com/watch?v=..."
                                        AutomationProperties.Name="YouTube URL"
                                        Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="15" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            AutomationProperties.LiveSetting="Polite" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Probe"
                                            Click="ProbeButton_Click"
                                            IsEnabled="{x:Bind ViewModel.ProbeEnabled, Mode=OneWay}"
                                            Padding="18,0" />
                                        <Button
                                            Grid.Column="2"
                                            Content="Choose folder"
                                            Click="ChooseFolderButton_Click"
                                            IsEnabled="{x:Bind ViewModel.FolderPickerEnabled, Mode=OneWay}"
                                            Padding="18,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="18"
                                CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Output settings" FontSize="18" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            Header="Mode"
                                            ItemsSource="{x:Bind ViewModel.ModeOptions}"
                                            SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Header="Format"
                                            ItemsSource="{x:Bind ViewModel.FormatOptions}"
                                            SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="2"
                                            Header="Quality"
                                            ItemsSource="{x:Bind ViewModel.QualityOptions}"
                                            SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Header="Trim start (optional)"
                                            PlaceholderText="0, 01:30, or 00:01:30"
                                            Text="{x:Bind ViewModel.TrimStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Header="Trim end (optional)"
                                            PlaceholderText="90, 03:00, or 00:03:00"
                                            Text="{x:Bind ViewModel.TrimEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Button
                                        Content="Add to queue"
                                        HorizontalAlignment="Left"
                                        Click="SubmitDownloadButton_Click"
                                        IsEnabled="{x:Bind ViewModel.SubmitEnabled, Mode=OneWay}"
                                        Padding="22,0" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Padding="18"
                                    CornerRadius="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="140"
                                            Height="90"
                                            CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image
                                                Source="{x:Bind ViewModel.ProbeThumbnail, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                AutomationProperties.Name="Video thumbnail" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <ProgressRing
                                                IsActive="{x:Bind ViewModel.IsProbing, Mode=OneWay}"
                                                Width="22"
                                                Height="22"
                                                AutomationProperties.Name="Probing video metadata" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.MetadataTitle, Mode=OneWay}"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.MetadataDetails, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="18"
                                    CornerRadius="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Local services" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.BackendStatus, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.WebSocketStatus, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="WrapWholeWords"
                                AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid
                    RowSpacing="16"
                    Visibility="{x:Bind ViewModel.QueuePageVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Download queue" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Live status is recovered from the backend after WebSocket reconnects. Completed jobs remain here for this app session."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"
                            AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.Name="Download queue" >
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadItem">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind JobDetails, Mode=OneWay}" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <ProgressBar
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                Height="6"
                                                AutomationProperties.Name="Download progress" />
                                            <TextBlock Text="{x:Bind ProgressDetails, Mode=OneWay}" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{x:Bind FilePath, Mode=OneWay}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Button
                                                Content="Cancel"
                                                IsEnabled="{x:Bind CanCancel, Mode=OneWay}"
                                                Click="CancelDownloadButton_Click" />
                                            <Button
                                                Content="Retry"
                                                IsEnabled="{x:Bind CanRetry, Mode=OneWay}"
                                                Click="RetryDownloadButton_Click" />
                                            <Button
                                                Content="Open file"
                                                IsEnabled="{x:Bind CanOpenFile, Mode=OneWay}"
                                                Click="OpenDownloadButton_Click" />
                                            <Button
                                                Content="Show in folder"
                                                IsEnabled="{x:Bind CanOpenFile, Mode=OneWay}"
                                                Click="RevealDownloadButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowSpacing="16"
                    Visibility="{x:Bind ViewModel.HistoryPageVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Download history" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind ViewModel.HistoryStatusMessage, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsLoadingHistory, Mode=OneWay}"
                                Width="20"
                                Height="20"
                                AutomationProperties.Name="Loading download history" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="WrapWholeWords"
                                AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Clear history"
                            VerticalAlignment="Center"
                            Click="ClearHistoryButton_Click"
                            IsEnabled="{x:Bind ViewModel.HistoryActionsEnabled, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.Name="Download history">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadHistoryRecord">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Summary, Mode=OneTime}" />
                                            <TextBlock Text="{x:Bind DownloadedAt, Mode=OneTime}" FontSize="12" />
                                            <TextBlock Text="{x:Bind FilePath, Mode=OneTime}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Button
                                                Content="Open file"
                                                IsEnabled="{x:Bind CanOpenFile, Mode=OneTime}"
                                                Click="OpenDownloadButton_Click" />
                                            <Button
                                                Content="Show in folder"
                                                IsEnabled="{x:Bind CanOpenFile, Mode=OneTime}"
                                                Click="RevealDownloadButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Window>
