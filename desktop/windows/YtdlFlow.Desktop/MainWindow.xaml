<Window
    x:Class="YtdlFlow.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YTDL Flow">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="YTDL Flow" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Native Windows desktop host" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Header="YouTube URL"
                PlaceholderText="https://www.youtube.com/watch?v=..."
                AutomationProperties.Name="YouTube URL"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay}"
                FontSize="15"/>

            <Button
                Grid.Column="1"
                Content="Probe"
                Click="ProbeButton_Click"
                IsEnabled="{x:Bind ViewModel.ProbeEnabled, Mode=OneWay}"
                Padding="20,0"/>

            <Button
                Grid.Column="2"
                Content="Choose Folder"
                Click="ChooseFolderButton_Click"
                IsEnabled="{x:Bind ViewModel.FolderPickerEnabled, Mode=OneWay}"
                Padding="20,0"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local services" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.BackendStatus, Mode=OneWay}" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.WebSocketStatus, Mode=OneWay}" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

                    <TextBlock Text="Download folder" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}" TextWrapping="WrapWholeWords" FontSize="14"/>

                    <TextBlock Text="Video metadata" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsProbing, Mode=OneWay}" Width="24" Height="24"/>
                    <TextBlock Text="{x:Bind ViewModel.MetadataTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                    <TextBlock Text="{x:Bind ViewModel.MetadataDetails, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Desktop status" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The native shell supervises the shared Node backend. Node remains authoritative for URL validation, engine lifecycle, downloads, and history." TextWrapping="WrapWholeWords"/>
                    <TextBlock Text="This phase supports backend status and real metadata probing. Download controls are not yet available." TextWrapping="WrapWholeWords" Margin="0,8,0,0"/>
                    <TextBlock Text="FFmpeg and FFprobe are external prerequisites. Optional Deno and cookie configuration are preserved." TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
